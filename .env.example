VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000
VITE_FIREBASE_APP_ID=1:000:web:000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-key
VITE_POSTHOG_PROJECT_TOKEN=phc_your_posthog_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Local dev connects to Firebase emulators by default.
# Set either flag below to use hosted Firebase from Vite dev.
VITE_USE_REAL_FIREBASE=false
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_PROJECT_ID=demo-locket-local
