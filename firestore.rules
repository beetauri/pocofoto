rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function currentCoupleId() {
      return signedIn() && userDoc(request.auth.uid).data.coupleId is string
        ? userDoc(request.auth.uid).data.coupleId
        : null;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && currentCoupleId() == coupleId
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.users;
    }

    function isValidCaption(caption) {
      return caption is map
        && caption.keys().hasOnly(['type', 'text'])
        && caption.type == 'text'
        && caption.text is string
        && caption.text.size() > 0
        && caption.text.size() <= 36
        && !caption.text.matches('.*(\\n|\\r).*')
        && !caption.text.matches('.*([Kk]ill|[Mm]urder|[Hh]urt).*[Yy]ou.*')
        && !caption.text.matches('.*([Rr]ape|[Ss]exual assault|[Nn]azi|[Tt]errorist).*');
    }

    function hasValidOptionalCaption() {
      return !('caption' in request.resource.data)
        || isValidCaption(request.resource.data.caption);
    }

    function isValidPaletteV2(palette) {
      return palette is map
        && palette.keys().hasOnly(['version', 'topColor', 'bottomColor', 'colors'])
        && palette.version == 2
        && palette.topColor is string
        && palette.topColor.matches('^#[0-9A-F]{6}$')
        && palette.bottomColor is string
        && palette.bottomColor.matches('^#[0-9A-F]{6}$')
        && palette.colors is list
        && palette.colors.size() == 2
        && palette.colors[0] == palette.topColor
        && palette.colors[1] == palette.bottomColor;
    }

    function hasValidOptionalPaletteV2() {
      return !('paletteV2' in request.resource.data)
        || isValidPaletteV2(request.resource.data.paletteV2);
    }

    function hasValidOptionalThumbnailUrl() {
      return !('thumbnailUrl' in request.resource.data)
        || (request.resource.data.thumbnailUrl is string
          && request.resource.data.thumbnailUrl.matches('https://.*'));
    }

    function hasValidOptionalThumbnailSize() {
      return !('thumbnailSize' in request.resource.data)
        || request.resource.data.thumbnailSize == 256;
    }

    function hasValidOptionalThumbnailFormat() {
      return !('thumbnailFormat' in request.resource.data)
        || request.resource.data.thumbnailFormat == 'webp';
    }

    function hasValidOptionalThumbnailMetadata() {
      return hasValidOptionalThumbnailUrl()
        && hasValidOptionalThumbnailSize()
        && hasValidOptionalThumbnailFormat();
    }

    function onlyOwnProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'email',
          'normalizedEmail',
          'displayName',
          'profilePic',
          'provider',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validDisplayNameUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
        || (request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2
          && request.resource.data.displayName.size() <= 30
          && request.resource.data.displayName.matches('.*\\S.*'));
    }

    match /users/{uid} {
      allow create: if ownUid(uid)
        && request.resource.data.coupleId == null
        && request.resource.data.provider in ['google', 'apple'];
      allow read: if ownUid(uid)
        || (signedIn()
          && resource.data.coupleId is string
          && resource.data.coupleId == currentCoupleId());
      allow update: if ownUid(uid) && onlyOwnProfileFields() && validDisplayNameUpdate();
      allow delete: if false;

      match /private/{documentId} {
        allow read: if ownUid(uid);
        allow write: if false;
      }

      match /private/blockedUsers/{blockedUid} {
        allow read, write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if ownUid(uid);
        allow update: if ownUid(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt']);
        allow create, delete: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if false;
      }
    }

    match /userContacts/{uid} {
      allow read: if ownUid(uid);
      allow write: if false;

      match /contacts/{contactId} {
        allow read: if ownUid(uid);
        allow write: if false;
      }
    }

    match /fcmTokenRegistry/{fingerprint} {
      allow read, write: if false;
    }

    match /contentReports/{reportId} {
      allow read, write: if false;
    }

    match /pairingRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow write: if false;
    }

    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    match /couples/{coupleId} {
      allow read: if isCoupleMember(coupleId);
      allow create: if false;
      allow update: if isCoupleMember(coupleId)
        && request.resource.data.users == resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentPhotoUrl', 'senderId', 'timestamp', 'liked', 'lastLike']);
      allow delete: if false;

      match /photos/{photoId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.senderId == request.auth.uid
          && hasValidOptionalCaption()
          && hasValidOptionalPaletteV2()
          && hasValidOptionalThumbnailMetadata();
        allow update: if isCoupleMember(coupleId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked']);
        allow delete: if false;
      }
    }
  }
}
