# Firebase / native configuration
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sixth-bonbon-402909
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Local development: leave true for the Firebase Emulator Suite.
# Android emulator uses 10.0.2.2; a physical device needs your Mac LAN IP.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
IOS_GOOGLE_SERVICES_FILE=
ANDROID_GOOGLE_SERVICES_FILE=

# Optional observability / analytics
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_AMPLITUDE_API_KEY=
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://p.pocofoto.com.tr
EXPO_PUBLIC_POSTHOG_SESSION_REPLAY=false
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# Optional release metadata
EXPO_PUBLIC_BUILD_COMMIT=dev
